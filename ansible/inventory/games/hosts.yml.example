# Real inventory is generated by `terraform apply` (main.tf → inventory/games/hosts.yml, git-ignored).
# This example mirrors its shape for --syntax-check / local reference.
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ~/.ssh/andusystems-proxmox
    metallb_address_pool: 10.238.70.50-10.238.70.69
    traefik_vip: 10.238.70.50
  children:
    k3s_servers:
      hosts:
        games-1: { ansible_host: 10.238.70.41 }
        games-2: { ansible_host: 10.238.70.42 }
        games-3: { ansible_host: 10.238.70.43 }
