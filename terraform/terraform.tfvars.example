# Real values come from TF_VAR_* env (GH secrets) on the runner — you normally don't need a tfvars.
# Copy to terraform.tfvars (git-ignored) only for local plans. PLACEHOLDERS below.

proxmox_endpoint  = "https://10.238.0.101:8006/"
proxmox_api_token = "terraform@pam!terraform=REPLACE_ME_UUID"

ssh_public_keys = ["ssh-ed25519 AAAA_REPLACE_ME games-cluster"]

# VLAN 70 + image defaults are already correct. Override node placement only if worker0/2/3
# lack capacity — e.g.:
# nodes = {
#   games-1 = { proxmox_host = "worker0", ip = "10.238.70.41", vm_id = 7041, cpu_cores = 2, memory_mb = 6144, disk_gb = 60 }
#   games-2 = { proxmox_host = "worker2", ip = "10.238.70.42", vm_id = 7042, cpu_cores = 2, memory_mb = 6144, disk_gb = 60 }
#   games-3 = { proxmox_host = "worker3", ip = "10.238.70.43", vm_id = 7043, cpu_cores = 2, memory_mb = 6144, disk_gb = 60 }
# }
